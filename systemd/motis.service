[Unit]
Description=MOTIS journey planner (123 OV)
After=network-online.target
Wants=network-online.target

[Service]
User=motis
Group=motis
WorkingDirectory=/var/lib/ov
# Port 8080 belongs to Nextcloud AIO on this server: always run MOTIS on 8090
ExecStartPre=-+/bin/sed -i -E "s/^([[:space:]]*port:[[:space:]]*)8080[[:space:]]*$/\\18090/" /var/lib/ov/data/config.yml
ExecStart=/opt/motis/motis server -d /var/lib/ov/data
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
