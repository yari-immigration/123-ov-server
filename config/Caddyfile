# Nextcloud AIO owns ports 80/443/8080/8443 on this server.
# Caddy serves the API over plain HTTP on 8091; Netlify (https://123-ov.nl/api/*) proxies to it.
{
	auto_https off
	admin localhost:2019
}

:8091 {
	encode zstd gzip

	handle_path /status/* {
		root * /var/lib/ov/status
		header Cache-Control "no-store"
		file_server
	}

	@api path /api/v1/geocode /api/v1/reverse-geocode /api/v6/plan /api/v6/stoptimes /api/v6/trip /api/v1/health
	handle @api {
		reverse_proxy 127.0.0.1:8090
	}

	handle {
		respond "123 OV API" 404
	}
}
